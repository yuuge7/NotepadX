<Window x:Class="NotepadX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:NotepadX.Models"
        xmlns:ctl="clr-namespace:NotepadX.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}"
        Height="720" Width="1040" MinWidth="480" MinHeight="320"
        WindowStyle="None" ResizeMode="CanResize"
        AllowDrop="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextRenderingMode="ClearType"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <!-- CaptionHeight covers the drag strip (14) plus the tab row (40). -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- Shortcuts live in MainWindow.BuildInputBindings: an InputBinding is a Freezable
         outside the visual tree, so Command="{Binding ...}" does not resolve here. -->

    <Window.Resources>

        <!-- ============ a single tab in the title bar ============ -->
        <DataTemplate x:Key="TabTemplate" DataType="{x:Type m:DocumentTab}">
            <!-- Bottom corners stay square and the bottom border is dropped, so the
                 active tab reads as continuous with the menu bar underneath it. -->
            <!-- No width here: TabStripPanel sizes every tab so a crowded strip still fits. -->
            <Border x:Name="TabRoot" Height="34"
                    Margin="0,6,2,0" CornerRadius="7,7,0,0"
                    Background="Transparent"
                    BorderThickness="1,1,1,0" BorderBrush="Transparent"
                    ToolTip="{Binding ToolTipText}"
                    AutomationProperties.Name="{Binding AccessibleName}"
                    AutomationProperties.ItemStatus="{Binding AccessibleStatus}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid Margin="10,0,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Unsaved marker: a dot rather than an asterisk glued to the name -->
                    <Ellipse x:Name="DirtyDot" Grid.Column="0" Width="7" Height="7" Margin="0,0,8,0"
                             VerticalAlignment="Center" Visibility="Collapsed"
                             Fill="{DynamicResource App.Accent}" />

                    <TextBlock x:Name="TabText" Grid.Column="1" Text="{Binding Title}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource App.TextSecondary}" />

                    <Button x:Name="CloseBtn" Grid.Column="2"
                            Style="{StaticResource TabCloseButtonStyle}"
                            Opacity="0"
                            ToolTip="Close tab (Ctrl+W)"
                            Content="{StaticResource Glyph.Close}"
                            Command="{Binding DataContext.CloseSpecificTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource App.Tab.Hover}" />
                    <Setter TargetName="CloseBtn" Property="Opacity" Value="1" />
                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource App.Text}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource App.Tab.Active}" />
                    <Setter TargetName="TabRoot" Property="BorderBrush" Value="{DynamicResource App.Tab.Border}" />
                    <Setter TargetName="CloseBtn" Property="Opacity" Value="1" />
                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource App.Text}" />
                    <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter TargetName="DirtyDot" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <Border x:Name="RootBorder"
            BorderBrush="{DynamicResource App.WindowBorder}"
            BorderThickness="1"
            Background="{DynamicResource App.Background}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <!-- drag strip -->
                <RowDefinition Height="40" />
                <!-- title bar + tabs -->
                <RowDefinition Height="Auto" />
                <!-- menu bar -->
                <RowDefinition Height="Auto" />
                <!-- find / replace -->
                <RowDefinition Height="*" />
                <!-- editor -->
                <RowDefinition Height="Auto" />
                <!-- status bar -->
            </Grid.RowDefinitions>

            <!-- ==================== DRAG STRIP ==================== -->
            <!-- Bare caption above the tabs. Nothing is hit-test-visible in chrome here, so
                 this row always drags the window even when the tab strip is full. -->
            <Border Grid.Row="0" Background="{DynamicResource App.TitleBar}" />

            <!-- ==================== TITLE BAR ==================== -->
            <Grid Grid.Row="1" Background="{DynamicResource App.TitleBar}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The ScrollViewer is deliberately not hit-test-visible in chrome: only the
                     tabs and the buttons are, so leftover strip space drags the window too.
                     It only scrolls once the tabs have shrunk to their minimum width. -->
                <ScrollViewer x:Name="TabScroller" Grid.Column="0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly"
                              PreviewMouseWheel="TabScroller_PreviewMouseWheel"
                              SizeChanged="TabScroller_SizeChanged">
                    <ItemsControl x:Name="TabList"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding Documents}"
                                  ItemTemplate="{StaticResource TabTemplate}"
                                  PreviewMouseLeftButtonDown="TabList_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="TabList_PreviewMouseMove"
                                  PreviewMouseLeftButtonUp="TabList_PreviewMouseLeftButtonUp"
                                  PreviewMouseDown="TabList_PreviewMouseDown">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- AvailableWidth is pushed from the code-behind rather than bound to
                                     the ScrollViewer: the viewport is a layout result, and feeding it
                                     back into the measure of its own content settles on stale values. -->
                                <ctl:TabStripPanel Loaded="TabStrip_Loaded" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                        Width="30" Height="30" Margin="4,5,4,0"
                        VerticalAlignment="Center"
                        ToolTip="New tab (Ctrl+N)"
                        Content="{StaticResource Glyph.Add}"
                        Command="{Binding NewTabCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            Content="{StaticResource Glyph.Minimize}" ToolTip="Minimize"
                            Click="Minimize_Click" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButtonStyle}"
                            Content="{StaticResource Glyph.Maximize}" ToolTip="Maximize"
                            Click="MaximizeRestore_Click" />
                    <Button Style="{StaticResource CaptionCloseButtonStyle}"
                            Content="{StaticResource Glyph.Close}" ToolTip="Close"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- ==================== MENU BAR ==================== -->
            <Grid Grid.Row="2" Background="{DynamicResource App.Surface}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Menu Grid.Column="0" Style="{StaticResource AppMenuStyle}" Margin="4,3" VerticalAlignment="Center">

                    <MenuItem Header="_File" Style="{StaticResource TopMenuItemStyle}">
                        <MenuItem Header="New tab" InputGestureText="Ctrl+N" Command="{Binding NewTabCommand}" />
                        <MenuItem Header="New window" InputGestureText="Ctrl+Shift+N" Command="{Binding NewWindowCommand}" />
                        <MenuItem Header="Open..." InputGestureText="Ctrl+O" Command="{Binding OpenCommand}" />
                        <Separator />
                        <MenuItem Header="Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
                        <MenuItem Header="Save as..." InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
                        <MenuItem Header="Save all" InputGestureText="Ctrl+Alt+S" Command="{Binding SaveAllCommand}" />
                        <Separator />
                        <MenuItem Header="Print..." InputGestureText="Ctrl+P" Command="{Binding PrintCommand}" />
                        <Separator />
                        <MenuItem Header="Close tab" InputGestureText="Ctrl+W" Command="{Binding CloseTabCommand}" />
                        <MenuItem Header="Reopen closed tab" InputGestureText="Ctrl+Shift+T" Command="{Binding ReopenClosedTabCommand}" />
                        <MenuItem Header="Close window" InputGestureText="Ctrl+Shift+W" Command="{Binding CloseWindowCommand}" />
                        <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
                    </MenuItem>

                    <MenuItem Header="_Edit" Style="{StaticResource TopMenuItemStyle}">
                        <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                        <MenuItem Header="Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                        <Separator />
                        <MenuItem Header="Cut" InputGestureText="Ctrl+X" Command="{Binding CutCommand}" />
                        <MenuItem Header="Copy" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}" />
                        <MenuItem Header="Paste" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}" />
                        <MenuItem Header="Delete" InputGestureText="Del" Command="{Binding DeleteCommand}" />
                        <Separator />
                        <MenuItem Header="Find" InputGestureText="Ctrl+F" Command="{Binding FindCommand}" />
                        <MenuItem Header="Find next" InputGestureText="F3" Command="{Binding FindNextCommand}" />
                        <MenuItem Header="Find previous" InputGestureText="Shift+F3" Command="{Binding FindPreviousCommand}" />
                        <MenuItem Header="Replace" InputGestureText="Ctrl+H" Command="{Binding ReplaceCommand}" />
                        <MenuItem Header="Go to..." InputGestureText="Ctrl+G" Command="{Binding GoToCommand}" />
                        <Separator />
                        <MenuItem Header="Select all" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" />
                        <MenuItem Header="Time/Date" InputGestureText="F5" Command="{Binding TimeDateCommand}" />
                        <Separator />
                        <MenuItem Header="Text tools">
                            <MenuItem Header="Sort lines A to Z" Command="{Binding TextToolCommand}" CommandParameter="sort" />
                            <MenuItem Header="Sort lines Z to A" Command="{Binding TextToolCommand}" CommandParameter="sortdesc" />
                            <MenuItem Header="Reverse line order" Command="{Binding TextToolCommand}" CommandParameter="reverse" />
                            <Separator />
                            <MenuItem Header="Remove duplicate lines" Command="{Binding TextToolCommand}" CommandParameter="dedupe" />
                            <MenuItem Header="Remove empty lines" Command="{Binding TextToolCommand}" CommandParameter="noempty" />
                            <MenuItem Header="Trim trailing whitespace" Command="{Binding TextToolCommand}" CommandParameter="trim" />
                            <MenuItem Header="Join lines" Command="{Binding TextToolCommand}" CommandParameter="join" />
                            <Separator />
                            <MenuItem Header="UPPERCASE" Command="{Binding TextToolCommand}" CommandParameter="upper" />
                            <MenuItem Header="lowercase" Command="{Binding TextToolCommand}" CommandParameter="lower" />
                            <MenuItem Header="Title Case" Command="{Binding TextToolCommand}" CommandParameter="title" />
                            <MenuItem Header="Invert case" Command="{Binding TextToolCommand}" CommandParameter="toggle" />
                            <Separator />
                            <MenuItem Header="Insert file path" Command="{Binding TextToolCommand}" CommandParameter="path" />
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="_View" Style="{StaticResource TopMenuItemStyle}">
                        <MenuItem Header="Zoom in" InputGestureText="Ctrl+Plus" Command="{Binding ZoomInCommand}" />
                        <MenuItem Header="Zoom out" InputGestureText="Ctrl+Minus" Command="{Binding ZoomOutCommand}" />
                        <MenuItem Header="Restore default zoom" InputGestureText="Ctrl+0" Command="{Binding ZoomResetCommand}" />
                        <Separator />
                        <MenuItem Header="Word wrap" IsCheckable="True"
                                  IsChecked="{Binding Settings.WordWrap, Mode=TwoWay}" />
                        <MenuItem Header="Line numbers" IsCheckable="True"
                                  IsChecked="{Binding Settings.ShowLineNumbers, Mode=TwoWay}" />
                        <MenuItem Header="Status bar" IsCheckable="True"
                                  IsChecked="{Binding Settings.ShowStatusBar, Mode=TwoWay}" />
                        <MenuItem Header="Word count in status bar" IsCheckable="True"
                                  IsChecked="{Binding Settings.ShowWordCount, Mode=TwoWay}" />
                        <MenuItem Header="Highlight all matches" IsCheckable="True"
                                  IsChecked="{Binding Settings.HighlightAllMatches, Mode=TwoWay}" />
                        <MenuItem Header="Spell check" IsCheckable="True"
                                  IsChecked="{Binding Settings.SpellCheck, Mode=TwoWay}" />
                        <Separator />
                        <MenuItem Header="Theme">
                            <MenuItem Header="Use system setting" IsCheckable="True" Tag="System"
                                      IsChecked="{Binding IsThemeSystem, Mode=TwoWay}" />
                            <MenuItem Header="Light" IsCheckable="True" Tag="Light"
                                      IsChecked="{Binding IsThemeLight, Mode=TwoWay}" />
                            <MenuItem Header="Dark" IsCheckable="True" Tag="Dark"
                                      IsChecked="{Binding IsThemeDark, Mode=TwoWay}" />
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                        Margin="0,0,6,0" ToolTip="Settings"
                        Content="{StaticResource Glyph.Settings}"
                        Command="{Binding SettingsCommand}" />
            </Grid>

            <!-- ==================== FIND / REPLACE ==================== -->
            <Border x:Name="FindBar" Grid.Row="3" Visibility="Collapsed"
                    Background="{DynamicResource App.SurfaceElevated}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FindBarSlide" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                        <TextBox x:Name="FindBox" Width="300"
                                 Style="{StaticResource SearchBoxStyle}"
                                 Tag="{StaticResource Glyph.Search}"
                                 KeyDown="FindBox_KeyDown" TextChanged="FindBox_TextChanged" />

                        <Button x:Name="HistoryButton" Style="{StaticResource IconButtonStyle}"
                                Width="26" FontSize="10" Margin="2,0,0,0"
                                Content="{StaticResource Glyph.ChevronDown}"
                                ToolTip="Recent searches" Click="FindHistory_Click" />

                        <Button Style="{StaticResource IconButtonStyle}" Margin="4,0,0,0"
                                Content="{StaticResource Glyph.ChevronUp}" ToolTip="Find previous (Shift+F3)"
                                Command="{Binding FindPreviousCommand}" />
                        <Button Style="{StaticResource IconButtonStyle}"
                                Content="{StaticResource Glyph.ChevronDown}" ToolTip="Find next (F3)"
                                Command="{Binding FindNextCommand}" />

                        <Rectangle Style="{StaticResource StatusSeparatorStyle}" Height="18" Margin="6,0" />

                        <ToggleButton x:Name="MatchCaseToggle" Style="{StaticResource IconToggleStyle}"
                                      Content="Aa" ToolTip="Match case"
                                      Checked="SearchOption_Changed" Unchecked="SearchOption_Changed" />
                        <ToggleButton x:Name="WholeWordToggle" Style="{StaticResource IconToggleStyle}"
                                      Content="ab" ToolTip="Match whole word"
                                      Checked="SearchOption_Changed" Unchecked="SearchOption_Changed" />
                        <ToggleButton x:Name="RegexToggle" Style="{StaticResource IconToggleStyle}"
                                      Content=".*" ToolTip="Use a regular expression"
                                      Checked="SearchOption_Changed" Unchecked="SearchOption_Changed" />
                        <ToggleButton x:Name="WrapAroundToggle" Style="{StaticResource IconToggleStyle}"
                                      ToolTip="Wrap around" IsChecked="True"
                                      FontFamily="{StaticResource IconFont}"
                                      Content="{StaticResource Glyph.Wrap}"
                                      Checked="SearchOption_Changed" Unchecked="SearchOption_Changed" />

                        <TextBlock x:Name="FindStatus" VerticalAlignment="Center" Margin="12,0,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource App.TextSecondary}" />
                    </StackPanel>

                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                            Content="{StaticResource Glyph.Close}" FontSize="10"
                            ToolTip="Close (Esc)" Click="CloseFind_Click" />

                    <StackPanel x:Name="ReplaceRow" Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                                Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBox x:Name="ReplaceBox" Width="300"
                                 Style="{StaticResource SearchBoxStyle}"
                                 Tag="{StaticResource Glyph.Replace}"
                                 KeyDown="ReplaceBox_KeyDown" />
                        <Button Content="Replace" Style="{StaticResource SubtleButtonStyle}"
                                Margin="6,0,0,0" Command="{Binding ReplaceOneCommand}" />
                        <Button Content="Replace all" Style="{StaticResource AccentButtonStyle}"
                                Margin="6,0,0,0" Command="{Binding ReplaceAllCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== EDITOR ==================== -->
            <Border Grid.Row="4" Background="{DynamicResource App.Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ctl:LineNumberGutter x:Name="Gutter" Grid.Column="0" Visibility="Collapsed"
                                          Foreground="{DynamicResource App.TextTertiary}"
                                          CurrentLineForeground="{DynamicResource App.Accent}"
                                          SeparatorBrush="{DynamicResource App.Divider}" />
                    <ContentControl x:Name="EditorHost" Grid.Column="1" Focusable="False" />
                </Grid>
            </Border>

            <!-- ==================== STATUS BAR ==================== -->
            <Border x:Name="StatusBarRoot" Grid.Row="5" Height="28"
                    Background="{DynamicResource App.StatusBar}"
                    BorderBrush="{DynamicResource App.Divider}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Margin="14,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.TextTertiary}" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding StatusLeft}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Style="{StaticResource StatusButtonStyle}" Content="{Binding StatusPosition}"
                                Command="{Binding GoToCommand}" ToolTip="Go to line (Ctrl+G)" />
                        <Rectangle Style="{StaticResource StatusSeparatorStyle}" />
                        <Button Style="{StaticResource StatusButtonStyle}" Content="{Binding StatusZoom}"
                                Click="ZoomStatus_Click" ToolTip="Zoom" />
                        <Rectangle Style="{StaticResource StatusSeparatorStyle}" />
                        <Button Style="{StaticResource StatusButtonStyle}"
                                Content="{Binding ActiveTab.LineEndingLabel}"
                                Click="LineEndingStatus_Click" ToolTip="Line endings" />
                        <Rectangle Style="{StaticResource StatusSeparatorStyle}" />
                        <Button Style="{StaticResource StatusButtonStyle}"
                                Content="{Binding ActiveTab.EncodingLabel}"
                                Click="EncodingStatus_Click" ToolTip="Encoding" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
