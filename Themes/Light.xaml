<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="App.Background"          Color="#EFEFEF" />
    <SolidColorBrush x:Key="App.TitleBar"            Color="#EFEFEF" />
    <SolidColorBrush x:Key="App.Surface"             Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.SurfaceAlt"          Color="#FBFBFB" />
    <SolidColorBrush x:Key="App.SurfaceElevated"     Color="#F9F9F9" />
    <SolidColorBrush x:Key="App.StatusBar"           Color="#FFFFFF" />

    <!-- Text -->
    <SolidColorBrush x:Key="App.Text"                Color="#1A1A1A" />
    <SolidColorBrush x:Key="App.TextSecondary"       Color="#5C5C5C" />
    <SolidColorBrush x:Key="App.TextTertiary"        Color="#8A8A8A" />

    <!-- Lines -->
    <SolidColorBrush x:Key="App.Border"              Color="#E3E3E3" />
    <SolidColorBrush x:Key="App.Divider"             Color="#EAEAEA" />
    <SolidColorBrush x:Key="App.WindowBorder"        Color="#C4C4C4" />
    <SolidColorBrush x:Key="App.Tab.Border"          Color="#E3E3E3" />

    <!-- Accent (replaced at runtime with the Windows accent colour) -->
    <SolidColorBrush x:Key="App.Accent"              Color="#0F6CBD" />
    <SolidColorBrush x:Key="App.AccentText"          Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.Selection"           Color="#0F6CBD" />

    <!-- Interaction -->
    <SolidColorBrush x:Key="App.Control.Hover"       Color="#14000000" />
    <SolidColorBrush x:Key="App.Control.Pressed"     Color="#22000000" />
    <SolidColorBrush x:Key="App.Tab.Active"          Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.Tab.Hover"           Color="#0F000000" />
    <SolidColorBrush x:Key="App.Close.Hover"         Color="#C42B1C" />

    <!-- Popup elevation -->
    <DropShadowEffect x:Key="App.PopupShadow" BlurRadius="18" ShadowDepth="4"
                      Direction="270" Color="#000000" Opacity="0.18" />

</ResourceDictionary>
