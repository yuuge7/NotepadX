<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="App.Background"          Color="#1C1C1C" />
    <SolidColorBrush x:Key="App.TitleBar"            Color="#1C1C1C" />
    <SolidColorBrush x:Key="App.Surface"             Color="#2B2B2B" />
    <SolidColorBrush x:Key="App.SurfaceAlt"          Color="#2D2D2D" />
    <SolidColorBrush x:Key="App.SurfaceElevated"     Color="#333333" />
    <SolidColorBrush x:Key="App.StatusBar"           Color="#2B2B2B" />

    <!-- Text -->
    <SolidColorBrush x:Key="App.Text"                Color="#F0F0F0" />
    <SolidColorBrush x:Key="App.TextSecondary"       Color="#B0B0B0" />
    <SolidColorBrush x:Key="App.TextTertiary"        Color="#8A8A8A" />

    <!-- Lines -->
    <SolidColorBrush x:Key="App.Border"              Color="#3D3D3D" />
    <SolidColorBrush x:Key="App.Divider"             Color="#383838" />
    <SolidColorBrush x:Key="App.WindowBorder"        Color="#4A4A4A" />
    <SolidColorBrush x:Key="App.Tab.Border"          Color="#3D3D3D" />

    <!-- Accent (replaced at runtime with the Windows accent colour) -->
    <SolidColorBrush x:Key="App.Accent"              Color="#60CDFF" />
    <SolidColorBrush x:Key="App.AccentText"          Color="#0A0A0A" />
    <SolidColorBrush x:Key="App.Selection"           Color="#0A64AD" />

    <!-- Interaction -->
    <SolidColorBrush x:Key="App.Control.Hover"       Color="#18FFFFFF" />
    <SolidColorBrush x:Key="App.Control.Pressed"     Color="#28FFFFFF" />
    <SolidColorBrush x:Key="App.Tab.Active"          Color="#2B2B2B" />
    <SolidColorBrush x:Key="App.Tab.Hover"           Color="#12FFFFFF" />
    <SolidColorBrush x:Key="App.Close.Hover"         Color="#C42B1C" />

    <!-- Popup elevation -->
    <DropShadowEffect x:Key="App.PopupShadow" BlurRadius="18" ShadowDepth="4"
                      Direction="270" Color="#000000" Opacity="0.55" />

</ResourceDictionary>
