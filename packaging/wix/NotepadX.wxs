<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user MSI. Installing into LocalAppData means no elevation prompt and no
  administrator rights, which matters for an app people install to try out.

  Build with:  wix build packaging\wix\NotepadX.wxs -d Version=1.0.0 -d SourceExe=... -o NotepadX.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="NotepadX"
           Manufacturer="yuuge7"
           Version="$(Version)"
           UpgradeCode="6f2c1d84-9a7e-4a4d-9a1b-2f0a5c7f3d21"
           Scope="perUser"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="NotepadX — offline text editor with tabs" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of NotepadX is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPHELPLINK" Value="https://github.com/yuuge7/NotepadX" />

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseFile)" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="NotepadX" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="NotepadX" />
    </StandardDirectory>

    <Feature Id="Main" Title="NotepadX" Level="1">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>

    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">

      <Component Id="Executable" Guid="1c0a8b6e-5d3f-4c1a-b0e6-7c9d4a2f8b51">
        <File Id="NotepadXExe" Source="$(SourceExe)" Name="NotepadX.exe" KeyPath="yes">
          <!-- Adds NotepadX to the Open with list. Windows still decides the default. -->
          <Shortcut Id="StartMenuShortcut"
                    Directory="ShortcutFolder"
                    Name="NotepadX"
                    Description="Offline text editor with tabs"
                    Advertise="yes"
                    Icon="AppIcon" />
        </File>

        <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder" On="uninstall" />

        <!-- One ProgId with one verb. A verb per extension would emit the same
             ProgId\shell\open\command row several times and fail the build; the other
             file types are added by the app itself from Settings › Default app. -->
        <ProgId Id="NotepadX.Document" Description="Text Document" Icon="NotepadXExe">
          <Extension Id="txt" ContentType="text/plain">
            <Verb Id="open" Command="Open" TargetFile="NotepadXExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <RegistryValue Root="HKCU"
                       Key="Software\Classes\Applications\NotepadX.exe"
                       Name="FriendlyAppName"
                       Value="NotepadX"
                       Type="string" />

        <!-- Offers NotepadX in "Open with" for the other plain-text types. -->
        <RegistryValue Root="HKCU" Key="Software\Classes\.log\OpenWithProgids"
                       Name="NotepadX.Document" Value="" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.md\OpenWithProgids"
                       Name="NotepadX.Document" Value="" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.ini\OpenWithProgids"
                       Name="NotepadX.Document" Value="" Type="string" />
      </Component>

    </ComponentGroup>
  </Package>
</Wix>
