<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user MSI. Installing into LocalAppData means no elevation prompt and no
  administrator rights, which matters for an app people install to try out.

  The program goes to %LOCALAPPDATA%\Programs\NotepadX, deliberately NOT to
  %LOCALAPPDATA%\NotepadX where the app keeps settings, session and recovery buffers.
  Keeping the two apart is what makes uninstall able to remove the install folder whole
  without taking the user's data with it, and keeps an upgrade from touching data at all.

  Build with:  wix build packaging\wix\NotepadX.wxs -ext WixToolset.Util.wixext
                   -d Version=1.0.0 -d SourceExe=... -o NotepadX.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="NotepadX"
           Manufacturer="yuuge7"
           Version="$(Version)"
           UpgradeCode="6f2c1d84-9a7e-4a4d-9a1b-2f0a5c7f3d21"
           Scope="perUser"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="NotepadX — offline text editor with tabs" />

    <!-- AllowSameVersionUpgrades: rebuilding the same version and installing it again
         replaces the existing install instead of landing a second entry in Installed apps
         that shares one component with the first. Downgrades stay blocked on purpose. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of NotepadX is already installed. Uninstall it from Settings &gt; Apps &gt; Installed apps first, then run this installer again." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Asks a running NotepadX to close before files are replaced. Without this the
         installer falls back to the Restart Manager, which can end up demanding a reboot. -->
    <util:CloseApplication Id="CloseNotepadX"
                           Target="NotepadX.exe"
                           CloseMessage="yes"
                           RebootPrompt="no"
                           PromptToContinue="yes"
                           Description="NotepadX is running. Close it to continue, then press Retry." />

    <Icon Id="AppIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPHELPLINK" Value="https://github.com/yuuge7/NotepadX" />

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseFile)" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="NotepadX" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="NotepadX" />
    </StandardDirectory>

    <Feature Id="Main" Title="NotepadX" Level="1">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>

    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">

      <!-- New GUID because the install path moved: a component GUID must always stand for
           the same file in the same place, or an upgrade leaves the old exe orphaned. -->
      <Component Id="Executable" Guid="93f69879-871b-4e5b-8ece-e28367d0b874">
        <File Id="NotepadXExe" Source="$(SourceExe)" Name="NotepadX.exe" KeyPath="yes">
          <!-- Adds NotepadX to the Open with list. Windows still decides the default. -->
          <Shortcut Id="StartMenuShortcut"
                    Directory="ShortcutFolder"
                    Name="NotepadX"
                    Description="Offline text editor with tabs"
                    Advertise="yes"
                    Icon="AppIcon" />
        </File>

        <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder" On="uninstall" />
        <!-- The install folder holds nothing but the exe now, so it goes too and no empty
             NotepadX folder is left under %LOCALAPPDATA%\Programs. -->
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />

        <!-- One ProgId with one verb. A verb per extension would emit the same
             ProgId\shell\open\command row several times and fail the build; the other
             file types are added by the app itself from Settings › Default app. -->
        <ProgId Id="NotepadX.Document" Description="Text Document" Icon="NotepadXExe">
          <Extension Id="txt" ContentType="text/plain">
            <Verb Id="open" Command="Open" TargetFile="NotepadXExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <RegistryValue Root="HKCU"
                       Key="Software\Classes\Applications\NotepadX.exe"
                       Name="FriendlyAppName"
                       Value="NotepadX"
                       Type="string" />

        <!-- Offers NotepadX in "Open with" for the other plain-text types. -->
        <RegistryValue Root="HKCU" Key="Software\Classes\.log\OpenWithProgids"
                       Name="NotepadX.Document" Value="" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.md\OpenWithProgids"
                       Name="NotepadX.Document" Value="" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.ini\OpenWithProgids"
                       Name="NotepadX.Document" Value="" Type="string" />
      </Component>

    </ComponentGroup>
  </Package>
</Wix>
