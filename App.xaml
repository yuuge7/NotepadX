<Application x:Class="NotepadX.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ThemeManager appends the Fluent control theme and the matching brush
                     set after this one at startup; later dictionaries win, so no light
                     palette may be merged here or it would beat the dark one. -->
                <ResourceDictionary Source="Themes/Shared.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
