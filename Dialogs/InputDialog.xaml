<Window x:Class="NotepadX.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotepadX"
        SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="18">
        <TextBlock x:Name="PromptText" Margin="0,0,0,8" TextWrapping="Wrap"
                   Foreground="{DynamicResource App.Text}" />
        <TextBox x:Name="ValueBox" Height="30" VerticalContentAlignment="Center"
                 KeyDown="ValueBox_KeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="90" Padding="0,5" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Width="90" Padding="0,5" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
