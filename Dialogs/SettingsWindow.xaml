<Window x:Class="NotepadX.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="620" Height="700" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource App.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,10,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="18,12,18,0">
            <StackPanel>

                <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="App theme" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="Follows the Windows setting unless you pick one." Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="180" VerticalAlignment="Center">
                            <ComboBoxItem Content="Use system setting" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                    </Grid>
                </Border>

                <TextBlock Text="Font" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Family" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="FontFamilyBox" Grid.Column="1" Width="240" IsEditable="False" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Size" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="FontSizeBox" Grid.Column="1" Width="240" IsEditable="True" />
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="BoldCheck" Content="Bold" Margin="0,0,20,0" />
                            <CheckBox x:Name="ItalicCheck" Content="Italic" />
                        </StackPanel>
                        <Border Margin="0,12,0,0" Padding="10" CornerRadius="6"
                                Background="{DynamicResource App.SurfaceAlt}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
                            <TextBlock x:Name="FontPreview" Text="The quick brown fox jumps over the lazy dog. 0123456789"
                                       TextWrapping="Wrap" Foreground="{DynamicResource App.Text}" />
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="Editing" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="WrapCheck" Content="Word wrap" Margin="0,0,0,8" />
                        <CheckBox x:Name="LineNumbersCheck" Content="Show line numbers" Margin="0,0,0,8" />
                        <CheckBox x:Name="StatusCheck" Content="Show status bar" Margin="0,0,0,8" />
                        <CheckBox x:Name="WordCountCheck" Content="Show word count in the status bar" Margin="0,0,0,8" />
                        <CheckBox x:Name="HighlightCheck" Content="Highlight every search match" Margin="0,0,0,8" />
                        <CheckBox x:Name="SpellCheckBox" Content="Spell check (offline Windows dictionary)" Margin="0,0,0,8" />
                        <CheckBox x:Name="IndentCheck" Content="Keep indentation on new lines" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Files" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Opening files" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="Where a file opens when it is launched from Explorer." Style="{StaticResource Hint}" />
                            </StackPanel>
                            <ComboBox x:Name="OpenInBox" Grid.Column="1" Width="180" VerticalAlignment="Center">
                                <ComboBoxItem Content="In a new tab" />
                                <ComboBoxItem Content="In a new window" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="When the app starts" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="Unsaved text is kept on this PC and restored." Style="{StaticResource Hint}" />
                            </StackPanel>
                            <ComboBox x:Name="StartupBox" Grid.Column="1" Width="180" VerticalAlignment="Center">
                                <ComboBoxItem Content="Continue previous session" />
                                <ComboBoxItem Content="Start with a new tab" />
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="AskSaveCheck" Content="Ask before closing tabs with unsaved changes" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Encoding for new files" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="EncodingBox" Grid.Column="1" Width="180" VerticalAlignment="Center" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Line endings for new files" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="EolBox" Grid.Column="1" Width="180" VerticalAlignment="Center">
                                <ComboBoxItem Content="Windows (CRLF)" />
                                <ComboBoxItem Content="Unix (LF)" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Default app" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="AssociationState" Style="{StaticResource RowLabel}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="Registering adds NotepadX to the Open with list and to Windows Settings. Windows itself will not let an app take over a file type — the last step is yours to confirm." />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="RegisterButton" Content="Register file types" Padding="12,5" Margin="0,0,8,0" Click="Register_Click" />
                            <Button x:Name="UnregisterButton" Content="Unregister" Padding="12,5" Margin="0,0,8,0" Click="Unregister_Click" />
                            <Button Content="Open Windows default apps" Padding="12,5" Click="OpenDefaultApps_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="VersionText" Style="{StaticResource RowLabel}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Offline by design. No account, no telemetry, no network calls, no AI features. Settings and recovered text stay in a local folder on this PC." />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Open data folder" Padding="12,5" Margin="0,0,8,0" Click="OpenDataFolder_Click" />
                            <Button Content="Reset to defaults" Padding="12,5" Click="Reset_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource App.StatusBar}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="18,10">
            <Button Content="Close" Width="100" Padding="0,5" HorizontalAlignment="Right"
                    IsDefault="True" IsCancel="True" Click="Close_Click" />
        </Border>
    </Grid>
</Window>
